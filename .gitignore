HELP.md
target/
# Local secrets and environment — only .env.example is ever shared.
.env
.env.*
!.env.example
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
application.properties
# The H2 test database config must travel with the code so `./mvnw test` never
# touches MySQL; only the real application.properties (with credentials) stays local.
!src/test/resources/application.properties

